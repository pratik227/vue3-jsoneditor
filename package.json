{
  "name": "v3-jsoneditor",
  "version": "0.1.0",
  "description": "Vue 3 JSON editor component — a modern, themeable wrapper around jsoneditor with v-model, dark mode, fullscreen and TypeScript types.",
  "type": "module",
  "main": "./dist/v3-jsoneditor.umd.cjs",
  "module": "./dist/v3-jsoneditor.js",
  "types": "./index.d.ts",
  "unpkg": "./dist/v3-jsoneditor.umd.cjs",
  "jsdelivr": "./dist/v3-jsoneditor.umd.cjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/v3-jsoneditor.js",
      "require": "./dist/v3-jsoneditor.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "index.d.ts",
    "llms.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratik227/vue3-jsoneditor.git"
  },
  "keywords": [
    "vue",
    "vuejs",
    "vue3",
    "json",
    "editor",
    "json editor",
    "component",
    "jsoneditor",
    "json-editor",
    "vue-component",
    "json schema",
    "dark mode",
    "nuxt"
  ],
  "author": "pratikpatelpp802@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pratik227/vue3-jsoneditor/issues"
  },
  "homepage": "https://v3-jsoneditor.netlify.app/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pratik227"
  },
  "dependencies": {
    "jsoneditor": "^10.4.3"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^7.3.7",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.32"
  }
}
